# Copie este arquivo para "keystore.properties" (sem o .example) na pasta android/,
# e preencha com os valores reais que você definiu ao gerar a chave.
# Esse arquivo NUNCA deve ir pro Git (já está no .gitignore).

storeFile=simple-finance-upload-key.jks
storePassword=COLOQUE_A_SENHA_DO_KEYSTORE_AQUI
keyAlias=simple-finance
keyPassword=COLOQUE_A_SENHA_DA_CHAVE_AQUI
