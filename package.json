{
  "name": "simple-finance",
  "version": "0.1.0",
  "private": true,
  "description": "Simple Finance – Web/Desktop/Mobile a partir do mesmo código React",
  "main": "electron/main.js",
  "author": "CROOMA Design Studio",
  "homepage": "https://croomastudio.com",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && electron electron/main.js\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.js",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:assets": "capacitor-assets generate --assetPath resources --iconBackgroundColor \"#0ea5e9\" --iconBackgroundColorDark \"#10151b\" --splashBackgroundColor \"#f7fbff\" --splashBackgroundColorDark \"#10151b\" && node scripts/fix-icon-background.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.1",
    "@revenuecat/purchases-capacitor": "^9.2.2",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.23.12",
    "react": "^18.2.0",
    "react-date-range": "^2.0.1",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.2.0",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.6",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vite": "^7.1.3",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.33.5": true,
    "@swc/core@1.15.47": true,
    "electron@30.5.1": true,
    "esbuild@0.28.1": true
  }
}
