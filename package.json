{
  "name": "controle-financeiro-bruno",
  "version": "1.2.0",
  "private": true,
  "description": "Controle Financeiro – Electron + React + Vite + Tailwind",
  "main": "main.js",
  "author": "Bruno + ChatGPT",
  "license": "MIT",
  "build": {
    "appId": "com.seuapp.financeiro",
    "productName": "ControleFinanceiro",
    "files": [
      "dist/**/*",
      "main.js"
    ],
    "win": {
      "target": "nsis"
    },
    "icon": "assets/icon.ico"
